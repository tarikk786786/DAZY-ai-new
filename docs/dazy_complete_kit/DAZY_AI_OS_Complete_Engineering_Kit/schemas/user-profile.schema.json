{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAZY User Profile",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "timezone",
    "profileVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "default": "Tarik"
    },
    "legalName": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "format": "email"
    },
    "avatarUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Kolkata"
    },
    "locale": {
      "type": [
        "string",
        "null"
      ]
    },
    "profileVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}